{
  "name": "ghostty-plugin-development",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p sdk && tsc -p tsconfig.json && tsc -p examples/git-status && tsc -p examples/git-status/tsconfig.view.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint host sdk/index.mts examples/git-status/*.mts examples/git-status/view.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
